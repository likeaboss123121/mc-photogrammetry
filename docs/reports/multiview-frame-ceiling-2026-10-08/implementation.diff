+def _pair_schedule(names: Sequence[str]) -> list[tuple[str, str]]:
+    """All pairs through eight frames; larger sets use a bounded cyclic graph.
+
+    ID ordering supplies adjacency, not an inferred camera or overlap ordering.
+    The distance-two ring covers each frame with triangles; omitted pairs have
+    unknown support. At 32 frames it evaluates 64 edges and 32 triangles.
+    """
+    if len(names) <= LEGACY_MAX_FRAMES:
+        return list(itertools.combinations(names, 2))
+    pairs = {tuple(sorted((name, names[(index + step) % len(names)])))
+             for index, name in enumerate(names) for step in (1, 2)}
+    return sorted(pairs)
+
+
+def _scheduled_triangles(names: Sequence[str], pairs: Sequence[tuple[str, str]]
+                         ) -> list[tuple[str, str, str]]:
+    edges = set(pairs)
+    return [(a, b, c) for a, b, c in itertools.combinations(names, 3)
+            if (a, b) in edges and (a, c) in edges and (b, c) in edges]
+
+
+def _output_limit(schema: str) -> int:
+    return EXTENDED_MAX_OUTPUT_BYTES if schema == "projective-plane-tracks-v5" else MAX_OUTPUT_BYTES
+
+
